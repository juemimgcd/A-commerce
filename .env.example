# 推荐运行 uv run scripts/configure_local.py 生成随机开发凭证，不要提交真实 .env。
POSTGRES_PASSWORD=replace_with_random_password
RABBITMQ_PASSWORD=replace_with_random_password
# 本地 HA 覆盖配置使用独立管理员/复制/API 凭证和 RabbitMQ 节点共享 cookie。
# 已有配置执行 configure_local.py --ha-secrets，不覆盖已有值。
POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_password
POSTGRES_REPLICATION_PASSWORD=replace_with_random_replication_password
PATRONI_API_PASSWORD=replace_with_random_api_password
RABBITMQ_ERLANG_COOKIE=replace_with_random_cluster_cookie
# 哨兵部署需要三组不同的 64 位十六进制随机密码。示例不能直接用于启动哨兵。
# 已有 .env 执行 configure_local.py --redis-secrets，只追加缺失字段。
REDIS_CACHE_PASSWORD=replace_with_64_hex_characters
REDIS_RATE_PASSWORD=replace_with_another_64_hex_characters
REDIS_SENTINEL_PASSWORD=replace_with_third_64_hex_password
# Sentinel 部署每次启动更新以下参数，保留已有卷中的主从角色。
REDIS_CACHE_MAXMEMORY=128mb
REDIS_RATE_MAXMEMORY=128mb
REDIS_SLOWLOG_MICROSECONDS=10000
REDIS_SLOWLOG_MAX_LEN=128
COMMERCE_ENVIRONMENT=development
# 全部 API、回调与 worker 升级并核验迁移后，再启用新商家活动订单。
COMMERCE_MERCHANT_PROMOTIONS_ENABLED=false
COMMERCE_DATABASE_URL=postgresql+asyncpg://commerce:replace_with_random_password@127.0.0.1:55432/commerce
# 单机模式不设置副本 URL；HA 覆盖配置仅为两个普通 API 注入 postgres-read 入口。
# COMMERCE_CATALOG_READ_DATABASE_URL=postgresql+asyncpg://reader:password@read-router:5432/commerce?target_session_attrs=standby
COMMERCE_CATALOG_READ_POOL_SIZE=5
COMMERCE_REDIS_URL=redis://127.0.0.1:56379/0
COMMERCE_RATE_REDIS_URL=redis://127.0.0.1:56380/0
# 宿主机开发默认直连；compose.redis-sentinel.yaml 会注入节点和认证配置。
# 自建 Sentinel 使用 COMMERCE_REDIS_SENTINEL__NODES='[["host1",26379],...]'
COMMERCE_AMQP_URL=amqp://commerce:replace_with_random_password@127.0.0.1:55672/commerce
COMMERCE_PROVIDER_URL=http://127.0.0.1:58001
COMMERCE_PROVIDER_KEY=replace_with_at_least_32_random_characters
COMMERCE_CALLBACK_SECRET=replace_with_another_32_random_characters
SIMULATOR_API_KEY=replace_with_at_least_32_random_characters
SIMULATOR_CALLBACK_SECRET=replace_with_another_32_random_characters
SIMULATOR_CALLBACK_URL=http://127.0.0.1:58000/api/v1/callbacks/payments/simulator
SIMULATOR_DATABASE_PATH=var/provider.sqlite3

# 后台维护：对账默认每天运行，归档与孤立上传清理每小时运行。
COMMERCE_RECONCILIATION_ENABLED=true
COMMERCE_RECONCILIATION_INTERVAL_SECONDS=86400
COMMERCE_MAINTENANCE_INTERVAL_SECONDS=3600
COMMERCE_EVENT_RETENTION_DAYS=90
COMMERCE_SNAPSHOT_SECONDS=900
COMMERCE_ORPHAN_GRACE_SECONDS=86400

# 初始限流预算：RATE 是每秒补充量，BURST 是桶容量；部署前按实测调整。
# 两个业务 API 必须使用相同配置和同一个限流 Redis，增加实例不增加共享额度。
COMMERCE_TRAFFIC__ORDER_GLOBAL__RATE=20
COMMERCE_TRAFFIC__ORDER_GLOBAL__BURST=30
COMMERCE_TRAFFIC__ORDER_SKU__RATE=5
COMMERCE_TRAFFIC__ORDER_SKU__BURST=8
# 网关只信任自身看到的源地址。若网段冲突，一并修改子网、动态地址池和固定地址。
COMMERCE_EDGE_SUBNET=172.29.83.0/24
COMMERCE_EDGE_RANGE=172.29.83.128/25
COMMERCE_GATEWAY_IP=172.29.83.2

# 后台容器在内网单独导出指标；宿主机默认关闭额外监听。监控通过 compose.monitoring.yaml 启用。
COMMERCE_METRICS_PORT=0

# 商品列表首页与详情：30–35 秒新鲜期，随后最多 120 秒允许返回旧值。
# 访问不延长期限；仅成功回源更新快照。每个 API 进程最多 4 个目录回源。
COMMERCE_CACHE_SECONDS=30
COMMERCE_CACHE_QUERY_SECONDS=15
COMMERCE_CACHE_RESPONSE_SECONDS=1
COMMERCE_REDIS_CONNECTIONS=50
COMMERCE_CACHE_STALE_SECONDS=120
COMMERCE_CACHE_ORIGIN_CONCURRENCY=4

# 可选客服：API 与独立 pi-adapter 进程必须设置同一个随机桥接密钥。
# 未设置密钥时不启用模型咨询；Node 进程需要显式导出环境变量。
# COMMERCE_SUPPORT_BRIDGE_SECRET=replace_with_at_least_32_random_characters
# COMMERCE_SUPPORT_ADAPTER_URL=http://127.0.0.1:58010
# COMMERCE_SUPPORT_TIMEOUT_SECONDS=90
# COMMERCE_SUPPORT_HOURLY_MESSAGES=30
# COMMERCE_PI_PROVIDER=your_provider
# COMMERCE_PI_MODEL=your_model
# COMMERCE_PI_API_KEY=your_model_credential
# COMMERCE_PI_STATE_DIR=var/commerce-pi
# COMMERCE_PI_MAX_TURNS=8
# COMMERCE_PI_MAX_TOOLS=12
# COMMERCE_PI_MAX_OUTPUT_TOKENS=1800
# COMMERCE_PI_TOKEN_BUDGET=64000
# COMMERCE_PI_RESERVE_TOKENS=4096
# COMMERCE_PI_CONTEXT_TOKENS=32768
# COMMERCE_PI_KEEP_RECENT_TOKENS=8000
# COMMERCE_PI_TIMEOUT_MS=85000
# COMMERCE_PI_CONCURRENCY=4
# COMMERCE_PI_RETENTION_DAYS=30
