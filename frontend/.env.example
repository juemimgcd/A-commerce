COMMERCE_API_ORIGIN=http://127.0.0.1:58000
# Only enable behind the included gateway; the Next server must not have a public port.
COMMERCE_TRUST_GATEWAY=false
# Public origin determines canonical links and the strict write-request origin check.
COMMERCE_WEB_ORIGIN=http://127.0.0.1:3000
# Enable only for a configured real store. Development remains noindex.
COMMERCE_INDEXABLE=false
